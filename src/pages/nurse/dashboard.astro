---
import Layout from '../../layouts/Layout.astro';
import { db } from '../../lib/db';
import { verifySession } from '../../lib/session';
import { Severity } from '@prisma/client';

const sessionCookie = Astro.cookies.get('maternalink_session')?.value;
const user = sessionCookie ? verifySession(sessionCookie) : null;

// Redirect legacy nurse dashboard to unified staff dashboard
return Astro.redirect('/staff/dashboard');

let successMessage = '';
let errorMessage = '';

// Load nurse's facility info
const nurseUser = await db.user.findUnique({
  where: { id: user.id },
  include: { healthFacility: true }
});

const facilityName = nurseUser?.healthFacility?.name || 'Mithi DHQ Hospital';
const facilityId = nurseUser?.healthFacilityId || 0;

// Handle alert resolution actions
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('action')?.toString();

    if (action === 'resolve') {
      const alertId = formData.get('alertId')?.toString() || '';
      const notes = formData.get('notes')?.toString().trim() || '';

      if (!alertId || !notes) {
        errorMessage = 'Please provide clinical action notes to resolve the alert.';
      } else {
        // Update Alert
        await db.alert.update({
          where: { id: alertId },
          data: {
            resolved: true,
            resolvedAt: new Date(),
            resolverId: user.id,
            message: `[RESOLVED BY NURSE: ${user.name}] Outcome Notes: ${notes}`
          }
        });

        // Log audit log
        await db.auditLog.create({
          data: {
            userId: user.id,
            action: 'RESOLVE_ALERT',
            details: `Resolved alert ${alertId} with notes: ${notes}.`
          }
        });

        successMessage = 'Emergency alert resolved and updated in central records.';
      }
    }
  } catch (err) {
    console.error("Nurse dashboard POST error:", err);
    errorMessage = 'Failed to process clinical resolution.';
  }
}

// Fetch active alerts for this facility or district
// Since this nurse is at Mithi DHQ Hospital, we fetch alerts triggered by visits of patients under the clinic's district
const alerts = await db.alert.findMany({
  where: {
    resolved: false
  },
  include: {
    visit: {
      include: {
        pregnancy: {
          include: {
            patient: true
          }
        }
      }
    }
  },
  orderBy: { createdAt: 'desc' }
});

// Fetch historical resolved alerts
const resolvedAlerts = await db.alert.findMany({
  where: {
    resolved: true
  },
  include: {
    visit: {
      include: {
        pregnancy: {
          include: {
            patient: true
          }
        }
      }
    },
    resolver: true
  },
  orderBy: { resolvedAt: 'desc' },
  take: 10
});

// Count active severe & critical alerts
const activeCriticalCount = alerts.filter(a => a.severity === Severity.CRITICAL).length;
const activeHighCount = alerts.filter(a => a.severity === Severity.HIGH).length;
---

<Layout title="Nurse DHQ Dashboard | Maternalink Cloud Obstetric Hub">
  <div class="min-h-screen text-[#2c1d30] flex flex-col font-sans relative overflow-x-hidden bg-cover bg-center bg-fixed" style="background-image: linear-gradient(rgba(28, 20, 33, 0.04), rgba(28, 20, 33, 0.07)), url('/dashboard.png');">
    
    <!-- Ambient glass styling: No global opaque covers, letting the backdrop stay 100% crisp and clear! -->

    <!-- Sticky Frosted Dark Navbar for premium grounding contrast -->
    <header class="sticky top-4 z-40 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-[#1c1421]/90 backdrop-blur-xl border border-white/10 rounded-[24px] px-6 py-4 flex items-center justify-between shadow-lg">
        <div class="flex items-center gap-3">
          <div class="w-3 h-3 rounded-full bg-gradient-to-tr from-[#fca27e] to-[#ebdcd5] shadow-sm"></div>
          <div>
            <h1 class="text-sm font-black text-white uppercase tracking-widest leading-none">Maternalink</h1>
            <p class="text-[9px] text-[#fca27e] font-black tracking-widest uppercase mt-0.5">Nurse · Referral HQ Hub</p>
          </div>
        </div>
        
        <div class="flex items-center gap-5">
          <div class="text-right hidden sm:block">
            <p class="text-xs font-bold text-white leading-none">{user.name}</p>
            <p class="text-[9px] text-[#ebdcd5]/70 font-mono tracking-wider mt-0.5">{facilityName}</p>
          </div>
          <a href="/logout" class="py-1.5 px-4 bg-white/10 hover:bg-rose-500/20 border border-white/15 hover:border-rose-400/40 text-slate-200 hover:text-white text-[9px] font-bold uppercase tracking-widest rounded-full transition-all cursor-pointer">
            Sign Out
          </a>
        </div>
      </div>
    </header>

    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 z-10 space-y-8">

      <!-- ==================== HEADER OPERATIONS CONSOLE ==================== -->
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mt-2">
        <div>
          <!-- Welcome Status Pill -->
          <div class="inline-flex items-center gap-2 px-3 py-1 bg-white/90 backdrop-blur-md border border-white/60 rounded-full shadow-sm mb-3">
            <span class="w-1.5 h-1.5 rounded-full bg-[#ebdcd5] border border-[#9b6fa0]"></span>
            <span class="text-[9px] font-black uppercase tracking-widest text-[#2c1d30]">Staff Duty: Nurse Panel · Secondary Obstetric Care</span>
          </div>
          <h2 class="text-3xl font-light text-[#2c1d30] tracking-tight" style="font-family: 'Outfit', sans-serif;">
            Clinical Referral <span class="font-extrabold text-[#9b6fa0]">Command Center</span>
          </h2>
          <p class="text-[11px] text-[#5c4a63] font-medium tracking-wide mt-1">
            Supervising field patient registrations, analyzing voice telemetry, and resolving high-urgency labor events.
          </p>
        </div>
        
        <!-- Live Action Dock & Voice Pill in Header -->
        <div class="flex flex-wrap items-center gap-3">
          <!-- Voice status indicator pill -->
          <div class="backdrop-blur-xl bg-white/90 border border-white/60 shadow-sm rounded-full px-3 py-1.5 flex items-center gap-2">
            <span class="relative flex h-1.5 w-1.5">
              <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-[#9b6fa0]"></span>
            </span>
            <span class="text-[9px] text-[#5c4a63] font-black tracking-wider uppercase">Filter / Verify Referral Data...</span>
          </div>

          <!-- Dock links -->
          <div class="backdrop-blur-xl bg-white/90 border border-white/60 shadow-sm rounded-full px-3.5 py-1.5 flex items-center gap-3.5">
            <a href="#overview" class="text-[#9b6fa0] hover:text-[#c47c3a] transition-all" title="Clinical Overview">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
              </svg>
            </a>
            <a href="#referrals" class="text-[#5c4a63] hover:text-rose-600 transition-all" title="Active Referrals Stream">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- ==================== HORIZONTAL OPERATIONAL STATS DOCK ==================== -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <!-- 1. Active Critical Referrals -->
        <div class="backdrop-blur-xl bg-white/75 border border-white/50 border-l-4 border-l-rose-500 shadow-2xl rounded-[32px] p-5 transition-all duration-300">
          <div class="flex items-center justify-between mb-2">
            <span class="text-[9px] font-black text-rose-600 uppercase tracking-widest">Active Critical Cases</span>
            {activeCriticalCount > 0 && (
              <span class="flex h-2 w-2 relative">
                <span class="relative inline-flex rounded-full h-2 w-2 bg-rose-500"></span>
              </span>
            )}
          </div>
          <p class="text-3xl font-black text-rose-600 font-mono leading-none">{activeCriticalCount}</p>
          <p class="text-[9px] text-[#5c4a63] font-semibold mt-2">Emergency cases awaiting resolution.</p>
        </div>

        <!-- 2. High-Risk Cases -->
        <div class="backdrop-blur-xl bg-[#fcf8f2]/75 border border-white/50 border-l-4 border-l-[#c47c3a] shadow-2xl rounded-[32px] p-5 transition-all duration-300">
          <div class="flex items-center justify-between mb-2">
            <span class="text-[9px] font-black text-[#765e82] uppercase tracking-widest">Active High-Risk</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-[#c47c3a]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
          <p class="text-3xl font-black text-[#c47c3a] font-mono leading-none">{activeHighCount}</p>
          <p class="text-[9px] text-[#5c4a63] font-semibold mt-2 font-sans">Requiring close supervision</p>
        </div>

        <!-- 3. Facility Location / Care Node -->
        <div class="backdrop-blur-xl bg-white/75 border border-white/50 shadow-2xl rounded-[32px] p-5 transition-all duration-300">
          <div class="flex items-center justify-between mb-3">
            <span class="text-[9px] font-black text-[#9b6fa0] uppercase tracking-widest flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
              District Referral Hub
            </span>
          </div>
          <div class="space-y-2 font-sans">
            <div class="flex justify-between text-[9px] text-[#5c4a63] font-bold">
              <span>Response Rate</span>
              <span class="text-[#c47c3a]">96.8%</span>
            </div>
            <div class="relative w-full bg-[#f4eef8]/80 h-2 rounded-full flex items-center">
              <div class="bg-gradient-to-r from-[#9b6fa0] to-[#c47c3a] h-full rounded-full" style="width: 96.8%;"></div>
              <div class="absolute w-3.5 h-3.5 bg-white border border-[#9b6fa0] rounded-full shadow-md cursor-pointer" style="left: calc(96.8% - 7px);"></div>
            </div>
          </div>
        </div>

        <!-- 4. Total Alerts Feed -->
        <div class="backdrop-blur-xl bg-white/75 border border-white/50 shadow-2xl rounded-[32px] p-5 transition-all duration-300">
          <div class="flex items-center justify-between mb-2">
            <span class="text-[9px] font-black text-[#765e82] uppercase tracking-widest">Active Alerts</span>
            <span class="text-[9px] px-2 py-0.5 bg-[#ebdcd5]/40 text-[#2c1d30] font-black font-mono rounded-full">{alerts.length} Total</span>
          </div>
          <p class="text-[9.5px] text-[#5c4a63] font-semibold mt-2.5 leading-normal">
             Lady Health Workers streaming checkups from Tharparkar villages in real-time.
          </p>
        </div>

      </div>

      <!-- Action status messages (Emerald / Rose capsules) -->
      {successMessage && (
        <div class="p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs flex items-center gap-3 max-w-3xl mx-auto shadow-sm">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-emerald-600 shrink-0" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span class="font-bold">{successMessage}</span>
        </div>
      )}

      {errorMessage && (
        <div class="p-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-800 text-xs flex items-center gap-3 max-w-3xl mx-auto shadow-sm">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-rose-600 shrink-0" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
          </svg>
          <span class="font-bold">{errorMessage}</span>
        </div>
      )}

      <!-- ==================== DATA GRIDS & FEED CONTROLS ==================== -->
      <div class="grid grid-cols-1 gap-8">
        
        <!-- Active emergency referrals feed -->
        <div class="backdrop-blur-xl bg-white/75 border border-white/50 shadow-2xl rounded-[32px] p-8">
          <div class="flex items-center justify-between mb-6 border-b border-[#2c2230]/8 pb-4">
            <h2 class="text-base font-black text-[#2c1d30] flex items-center gap-2.5">
              <span class="w-1.5 h-6 bg-[#9b6fa0] rounded-full"></span>
              Active Emergency Referrals & Field Alerts
            </h2>
            <span class="text-[9px] uppercase tracking-widest font-extrabold bg-[#172033]/90 border border-white/10 text-brand-sand py-1 px-3 rounded-full">
              Real-Time Cloud Feed
            </span>
          </div>

          {alerts.length === 0 ? (
            <div class="text-center py-12 text-[#765e82] text-xs font-bold uppercase tracking-wider">
              🎉 No active referrals or alerts for your facility. Mothers in Tharparkar are currently stable!
            </div>
          ) : (
            <div class="space-y-6">
              {alerts.map(alert => {
                const visit = alert.visit;
                const preg = visit.pregnancy;
                const patient = preg.patient;
                
                let cardColor = 'border-l-4 border-l-[#9b6fa0] bg-[#ebdbeb]/10';
                let tagColor = 'bg-[#9b6fa0]/10 text-[#9b6fa0] border-[#9b6fa0]/20';

                if (alert.severity === Severity.CRITICAL) {
                  cardColor = 'border-l-4 border-l-red-500 bg-red-50/10';
                  tagColor = 'bg-red-50 text-red-700 border-red-200';
                } else if (alert.severity === Severity.HIGH) {
                  cardColor = 'border-l-4 border-l-[#c47c3a] bg-[#fdf5f2]/20';
                  tagColor = 'bg-orange-50 text-orange-700 border-orange-200';
                }

                return (
                  <div class={`border border-white/40 rounded-[28px] p-6 transition-all duration-300 relative bg-white/70 backdrop-blur-xl shadow-xl ${cardColor}`}>
                    
                    <div class="flex flex-wrap items-start justify-between gap-4 mb-4">
                      <div>
                        <div class="flex items-center gap-2.5">
                          <h3 class="text-base font-black text-[#2c1d30]">{patient.name}</h3>
                          <span class="text-xs text-[#765e82] font-semibold">(Age: {patient.age}, Village: {patient.address})</span>
                          <span class={`text-[9px] uppercase font-extrabold tracking-widest px-2 py-0.5 rounded-full border ${tagColor}`}>
                            {alert.severity}
                          </span>
                        </div>
                        <p class="text-xs text-[#9b6fa0] font-semibold mt-1">LMP: {new Date(preg.startDate).toLocaleDateString()} | EDD: {new Date(preg.expectedDueDate).toLocaleDateString()} | Gestational Age: {visit.gestationalWeeks} weeks</p>
                      </div>
                      <span class="text-[10px] font-mono text-slate-500 font-bold">{new Date(alert.createdAt).toLocaleString()}</span>
                    </div>

                    <!-- Clinical values overlay -->
                    <div class="grid grid-cols-2 sm:grid-cols-5 gap-4 p-4 bg-white/75 border border-white/40 rounded-xl text-center mb-4">
                      <div>
                        <p class="text-[9px] text-[#765e82] font-bold uppercase tracking-widest">Blood Pressure</p>
                        <p class="text-base font-extrabold font-mono text-[#2c1d30] mt-1">{visit.systolicBP}/{visit.diastolicBP} <span class="text-[9px] font-normal text-[#765e82]">mmHg</span></p>
                      </div>
                      <div>
                        <p class="text-[9px] text-[#765e82] font-bold uppercase tracking-widest">Hemoglobin</p>
                        <p class="text-base font-extrabold font-mono text-[#2c1d30] mt-1">{visit.hemoglobin} <span class="text-[9px] font-normal text-[#765e82]">g/dL</span></p>
                      </div>
                      <div>
                        <p class="text-[9px] text-[#765e82] font-bold uppercase tracking-widest">Fetal Heart Rate</p>
                        <p class="text-base font-extrabold font-mono text-[#2c1d30] mt-1">{visit.fetalHeartRate || 'N/A'} <span class="text-[9px] font-normal text-[#765e82]">bpm</span></p>
                      </div>
                      <div>
                        <p class="text-[9px] text-[#765e82] font-bold uppercase tracking-widest">Weight</p>
                        <p class="text-base font-extrabold font-mono text-[#2c1d30] mt-1">{visit.weight} <span class="text-[9px] font-normal text-[#765e82]">kg</span></p>
                      </div>
                      <div class="col-span-2 sm:col-span-1">
                        <p class="text-[9px] text-[#765e82] font-bold uppercase tracking-widest">Symptoms</p>
                        <p class="text-xs text-[#2c1d30] font-bold mt-1 truncate">
                          {JSON.parse(visit.symptoms).join(', ') || 'None'}
                        </p>
                      </div>
                    </div>

                    <!-- Voice transcript and AI advice -->
                    <div class="space-y-4 mb-5 text-xs">
                      <div>
                        <p class="text-[#765e82] font-bold tracking-wider uppercase text-[9px] mb-1">Field LHW spoken Note / Transcription:</p>
                        <div class="p-3.5 bg-white/70 border border-white/40 rounded-xl text-[#5c4a63] italic font-medium leading-relaxed">
                          "{visit.voiceTranscript}"
                        </div>
                      </div>
                      <div>
                        <p class="text-[#9b6fa0] font-bold tracking-wider uppercase text-[9px] mb-1">Clinical Decision Support & Urgency Details:</p>
                        <div class="p-4 bg-[#9b6fa0]/5 border border-[#9b6fa0]/15 rounded-xl text-[#2c1d30] leading-relaxed">
                          {alert.message}
                          <div class="mt-3 text-[10px] text-[#765e82] border-t border-[#2c2230]/8 pt-2 flex items-center justify-between">
                            <span class="font-semibold">Clinical Risk Assessment Score: <strong class="text-[#c47c3a] font-mono">{visit.riskScore}%</strong></span>
                            <span class="font-semibold">Advice Code: <strong class="text-[#c47c3a] font-mono">{visit.medications}</strong></span>
                          </div>
                        </div>
                      </div>
                    </div>

                    <!-- Resolve action form -->
                    <form method="POST" class="border-t border-[#2c2230]/8 pt-4">
                      <input type="hidden" name="action" value="resolve" />
                      <input type="hidden" name="alertId" value={alert.id} />
                      
                      <div class="flex flex-col sm:flex-row gap-3">
                        <input 
                          type="text" 
                          name="notes" 
                          required 
                          placeholder="Type clinical action outcome (e.g. Admitted Zainab Bibi, administered Magnesium Sulfate IV, monitored vitals)" 
                          class="flex-1 py-2.5 px-4 bg-white border border-[#2c2230]/10 focus:border-[#9b6fa0] rounded-xl text-[#2c1d30] text-xs focus:outline-none placeholder-slate-400 transition-all focus:ring-1 focus:ring-[#9b6fa0]/30"
                        />
                        <button 
                          type="submit" 
                          class="py-2.5 px-5 bg-[#1c1421] hover:bg-[#2c2033] text-white font-extrabold text-xs tracking-wider uppercase rounded-xl shadow-sm transition-all shrink-0 cursor-pointer"
                        >
                          Resolve Alert & Update Record
                        </button>
                      </div>
                    </form>

                  </div>
                );
              })}
            </div>
          )}
        </div>

        <!-- Historical Alerts Resolved Log -->
        <div class="backdrop-blur-xl bg-white/75 border border-white/50 shadow-2xl rounded-[32px] p-8">
          <h2 class="text-base font-black text-[#2c1d30] mb-6 flex items-center gap-2">
            <span class="w-1.5 h-6 bg-[#c47c3a] rounded-full"></span>
            Recent Resolved Actions Log
          </h2>

          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs border-collapse">
              <thead>
                <tr class="border-b border-[#2c2230]/8 text-[#765e82] font-bold uppercase tracking-wider">
                  <th class="py-3 px-4 text-[10px]">Patient</th>
                  <th class="py-3 px-4 text-[10px]">Condition (Alert Type)</th>
                  <th class="py-3 px-4 text-[10px]">Nurse Resolver</th>
                  <th class="py-3 px-4 text-[10px]">Resolution Notes / Outcome</th>
                  <th class="py-3 px-4 text-[10px]">Date Resolved</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-[#2c2230]/6 text-[#5c4a63] font-sans">
                {resolvedAlerts.length === 0 ? (
                  <tr>
                    <td colspan="5" class="text-center py-8 text-[#765e82] font-bold uppercase tracking-wider">No resolved emergency actions log present.</td>
                  </tr>
                ) : (
                  resolvedAlerts.map(alert => (
                    <tr class="hover:bg-white/60 transition-all">
                      <td class="py-4 px-4 font-black text-[#2c1d30]">{alert.visit.pregnancy.patient.name}</td>
                      <td class="py-4 px-4"><span class="text-[#9b6fa0] font-bold uppercase tracking-wider text-[10px]">{alert.severity}</span></td>
                      <td class="py-4 px-4 text-[#c47c3a] font-bold">{alert.resolver?.name || 'Assigned Staff'}</td>
                      <td class="py-4 px-4 text-[#5c4a63] italic max-w-xs truncate">{alert.message.split('Outcome Notes:')[1] || alert.message}</td>
                      <td class="py-4 px-4 text-[#765e82] font-mono font-bold">{new Date(alert.resolvedAt).toLocaleDateString()}</td>
                    </tr>
                  ))
                )}
              </tbody>
            </table>
          </div>
        </div>

      </div>

    </main>
  </div>
</Layout>
