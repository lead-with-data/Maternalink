<Layout title="Clinical & Frontline Staff Dashboard | Maternalink Cloud Obstetric Hub">
  <div class="min-h-screen text-[#2c1d30] flex flex-col font-sans relative overflow-x-hidden bg-cover bg-center bg-fixed" style="background-image: linear-gradient(rgba(28, 20, 33, 0.04), rgba(28, 20, 33, 0.07)), url('/login-signup.png');">
    
    <!-- Sticky frosted header -->
    <header class="sticky top-4 z-40 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8">
