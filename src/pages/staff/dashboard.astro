          <div class="w-3 h-3 rounded-full bg-gradient-to-tr from-[#fca27e] to-[#ebdcd5] shadow-sm"></div>
          <div>
            <h1 class="text-sm font-black text-white uppercase tracking-widest leading-none">Maternalink</h1>
            <p class="text-[9px] text-[#fca27e] font-black tracking-widest uppercase mt-0.5">Staff · Unified Command Hub</p>
          </div>
        </div>

        <div class="flex items-center gap-5">
          <!-- Premium Language Toggle (English / Urdu) -->
          <div class="bg-white/10 p-0.5 rounded-full border border-white/10 flex items-center">
            <button id="lang-btn-en" class="px-3 py-1 rounded-full text-[9px] font-black uppercase tracking-wider transition-all cursor-pointer bg-white/20 text-white" onclick="setLanguage('en')">EN</button>
            <button id="lang-btn-ur" class="px-3 py-1 rounded-full text-[9px] font-black uppercase tracking-wider transition-all cursor-pointer text-slate-400" onclick="setLanguage('ur')">اردو</button>
