      "checkup-danger": "حمل کی خطرناک علامات",
      "checkup-voice": "اردو وائس نوٹ / کیس ٹرانسکرپٹ",
      "checkup-submit": "صحت کی علامات درج کریں اور خطرہ جانچیں",
      "active-alerts-title": "سرگرم ہنگامی ریفرلز اور فیلڈ الرٹس",
      "resolved-alerts-title": "حالیہ حل شدہ کارروائیوں کا لاگ",
      "cohort-ledger-title": "مریضوں کا کھاتہ اور طبی نتائج",
      "sign-out": "سائن آؤٹ",
      "mother-placeholder": "مثلاً فاطمہ بائی",
      "mobile-placeholder": "مثلاً 03001234567",
      "cnic-placeholder": "مثلاً 8-1234567-44301",
      "age-placeholder": "مثلاً 26",
      "address-placeholder": "مثلاً گاؤں مٹھریو، ڈپلو",
      "family-placeholder": "مثلاً 03017654321",
      "weeks-placeholder": "ہفتے",
      "gravida-placeholder": "مثلاً 2",
      "para-placeholder": "مثلاً 1",
      "notes-placeholder": "طبی کارروائی کا نتیجہ درج کریں (مثلاً زینب بی بی کو داخل کیا گیا، آئی وی میگنیشیم سلفیٹ دیا گیا)",
      "resolve-submit": "الرٹ حل کریں اور ریکارڈ اپ ڈیٹ کریں"
    }
  };

  window.setLanguage = function(lang) {
    localStorage.setItem('maternalink_lang', lang);
    document.querySelectorAll('[data-translate]').forEach(el => {
      const key = el.getAttribute('data-translate');
      if (translations[lang] && translations[lang][key]) {
        el.innerText = translations[lang][key];
      }
    });
    // Translate placeholders too
    document.querySelectorAll('[data-translate-placeholder]').forEach(el => {
      const key = el.getAttribute('data-translate-placeholder');
      if (translations[lang] && translations[lang][key]) {
        el.setAttribute('placeholder', translations[lang][key]);
      }
    });

    const btnEn = document.getElementById('lang-btn-en');
    const btnUr = document.getElementById('lang-btn-ur');
    if (lang === 'ur') {
      btnUr.classList.add('bg-white/20', 'text-white');
      btnUr.classList.remove('text-slate-400');
      btnEn.classList.remove('bg-white/20', 'text-white');
      btnEn.classList.add('text-slate-400');
    } else {
      btnEn.classList.add('bg-white/20', 'text-white');
      btnEn.classList.remove('text-slate-400');
      btnUr.classList.remove('bg-white/20', 'text-white');
      btnUr.classList.add('text-slate-400');
    }
  };

  // Restore client preference on load
  const savedLang = localStorage.getItem('maternalink_lang') || 'en';
  window.setLanguage(savedLang);

  // Longitudinal Cohort Data update listener
  const pregnancySelect = document.querySelector('select[name="pregnancyId"]');
  const longitudinalPanel = document.getElementById('longitudinalPanel');
  const timelineText = document.getElementById('longitudinalTimeline');
  const bpTrendText = document.getElementById('longitudinalBPTrend');
  const anemiaText = document.getElementById('longitudinalAnemia');
  const medsText = document.getElementById('longitudinalMeds');
  const aiPredictionText = document.getElementById('longitudinalAIPrediction');
  const metadataText = document.getElementById('longitudinalMetadata');

  function updateLongitudinalContext() {
    if (!pregnancySelect) return;
    const selectedPregId = pregnancySelect.value;
    if (!selectedPregId) return;

    let matchedPatient = null;
    let matchedPregnancy = null;

    for (const p of window.LHW_PATIENTS_DATA) {
      const activePreg = p.pregnancies.find(pr => pr.id === selectedPregId);
      if (activePreg) {
        matchedPatient = p;
        matchedPregnancy = activePreg;
        break;
      }
    }

    if (!matchedPatient || !matchedPregnancy) {
      if (longitudinalPanel) longitudinalPanel.classList.add('hidden');
      return;
    }

    if (longitudinalPanel) longitudinalPanel.classList.remove('hidden');

    const visits = matchedPregnancy.visits || [];
    const weeks = visits[0] ? visits[0].gestationalWeeks : 20;
    const g = matchedPregnancy.gravida || 1;
    const p = matchedPregnancy.parity || 0;
    timelineText.innerHTML = `Active Gestation: <strong>${weeks} Weeks</strong> | G${g} P${p} (Age ${matchedPatient.age})`;

    const meta = matchedPatient.metadata || {};
    metadataText.innerHTML = `
      <div class="grid grid-cols-2 gap-2 text-[10px] text-[#5c4a63] font-semibold border-t border-[#ebdcd5]/50 pt-2.5 mt-2">
        <div><strong>Education:</strong> ${meta.education || 'None'}</div>
        <div><strong>Socioeconomic:</strong> ${meta.socioeconomic || 'Low'}</div>
        <div><strong>Hospital Distance:</strong> ${meta.hospitalDistance ? meta.hospitalDistance + ' km' : 'N/A'}</div>
        <div><strong>Clean Water:</strong> ${meta.cleanWaterAccess || 'No'}</div>
        <div><strong>C-Sections:</strong> ${meta.cSections || 0}</div>
        <div><strong>Miscarriages:</strong> ${meta.miscarriages || 0}</div>
        <div><strong>Husband Contact:</strong> ${meta.familyContact || 'N/A'}</div>
      </div>
    `;

    if (visits.length === 0) {
      bpTrendText.innerHTML = "Baseline vitals pending.";
      anemiaText.innerHTML = "Baseline hemoglobin pending.";
      medsText.innerHTML = "None advised yet.";
      if (aiPredictionText) aiPredictionText.innerHTML = "No longitudinal history yet.";
    } else {
      const bpList = [...visits].reverse().map(v => `${v.systolicBP}/${v.diastolicBP}`);
      let bpWarning = '';
      if (visits.length >= 2) {
        const latestSys = visits[0].systolicBP;
        const prevSys = visits[1].systolicBP;
        if (latestSys > prevSys + 10) {
          bpWarning = ' <span class="text-rose-600 font-extrabold animate-pulse">(⚠️ RISING BP)</span>';
        }
      }
      bpTrendText.innerHTML = `${bpList.join(' → ')}${bpWarning}`;

      const hbList = [...visits].reverse().map(v => `${v.hemoglobin} g/dL`);
      let anemiaWarning = '';
      const latestHb = visits[0].hemoglobin;
      if (latestHb < 10.0) {
        anemiaWarning = ` <span class="text-amber-600 font-extrabold">(⚠️ Anemic - Hb: ${latestHb})</span>`;
      }
      anemiaText.innerHTML = `${hbList.join(' → ')}${anemiaWarning}`;

      const pastMeds = visits.map(v => v.medications).filter(Boolean).join('; ');
      medsText.innerHTML = pastMeds ? [...new Set(pastMeds.split('; '))].join('; ') : "Standard Prenatal Iron Adherence advised.";
      
      const latestAiPrediction = visits[0]?.aiPrediction || "Calculating initial baseline trajectory...";
      if (aiPredictionText) aiPredictionText.innerHTML = latestAiPrediction;
    }
  }

  if (pregnancySelect) {
    pregnancySelect.addEventListener('change', updateLongitudinalContext);
    updateLongitudinalContext();
  }

  // BMI Calculator
  const weightInput = document.querySelector('input[name="weight"]');
  const heightInput = document.querySelector('input[name="height"]');
  const bmiDisplay = document.getElementById('bmiDisplay');

  function calculateBMI() {
    if (!weightInput || !heightInput || !bmiDisplay) return;
    const w = parseFloat(weightInput.value);
    const h = parseFloat(heightInput.value);
    
    if (w > 0 && h > 0) {
      const bmi = (w / (h * h)).toFixed(1);
      let classification = 'Normal';
      let colorClass = 'text-emerald-600';
      
      if (bmi < 18.5) {
        classification = 'Underweight';
        colorClass = 'text-amber-600';
      } else if (bmi >= 25 && bmi < 30) {
        classification = 'Overweight';
        colorClass = 'text-amber-600';
      } else if (bmi >= 30) {
        classification = 'Obese';
        colorClass = 'text-rose-600';
      }
      
      bmiDisplay.innerHTML = `Calculated BMI: <strong class="${colorClass}">${bmi}</strong> (${classification})`;
    } else {
      bmiDisplay.innerHTML = '';
    }
  }



  if (weightInput && heightInput) {
    weightInput.addEventListener('input', calculateBMI);
    heightInput.addEventListener('input', calculateBMI);
  }

  // API Explorer Console logic
  const minAgeInput = document.getElementById('api-minAge');
  const maxAgeInput = document.getElementById('api-maxAge');
  const riskCategorySelect = document.getElementById('api-riskCategory');
  const limitInput = document.getElementById('api-limit');
  const runApiBtn = document.getElementById('btn-run-api');
  const curlCodeDiv = document.getElementById('api-curl-code');
  const responseStatusSpan = document.getElementById('response-status');
  const responseJsonViewer = document.getElementById('response-json-viewer');

  function updateCurlCommand() {
    if (!curlCodeDiv) return;
    const minAge = minAgeInput?.value || '';
    const maxAge = maxAgeInput?.value || '';
    const risk = riskCategorySelect?.value || '';
    const limit = limitInput?.value || '5';

    let params = [];
    if (minAge) params.push(`minAge=${minAge}`);
    if (maxAge) params.push(`maxAge=${maxAge}`);
    if (risk) params.push(`riskCategory=${risk}`);
    if (limit) params.push(`limit=${limit}`);

    const queryString = params.length > 0 ? '?' + params.join('&') : '';
    curlCodeDiv.innerText = `curl -X GET "http://localhost:3000/api/labs${queryString}" \\\n  -H "x-api-key: MATERNALINK_LABS_KEY_2026"`;
  }

  if (minAgeInput) minAgeInput.addEventListener('input', updateCurlCommand);
  if (maxAgeInput) maxAgeInput.addEventListener('input', updateCurlCommand);
  if (riskCategorySelect) riskCategorySelect.addEventListener('change', updateCurlCommand);
  if (limitInput) limitInput.addEventListener('input', updateCurlCommand);

  if (runApiBtn) {
    runApiBtn.addEventListener('click', async () => {
      if (responseStatusSpan) responseStatusSpan.innerText = "Status: Querying...";
      if (responseJsonViewer) responseJsonViewer.innerText = "Connecting to telemetry data warehouse...";

      const minAge = minAgeInput?.value || '';
      const maxAge = maxAgeInput?.value || '';
      const risk = riskCategorySelect?.value || '';
      const limit = limitInput?.value || '5';

      let params = [];
      if (minAge) params.push(`minAge=${minAge}`);
      if (maxAge) params.push(`maxAge=${maxAge}`);
      if (risk) params.push(`riskCategory=${risk}`);
      if (limit) params.push(`limit=${limit}`);

      const queryString = params.length > 0 ? '?' + params.join('&') : '';
      const url = `/api/labs${queryString}`;

      try {
        const res = await fetch(url, {
          method: 'GET',
          headers: {
            'x-api-key': 'MATERNALINK_LABS_KEY_2026',
            'Accept': 'application/json'
          }
        });

        if (responseStatusSpan) responseStatusSpan.innerText = `Status: ${res.status} ${res.statusText}`;
        const data = await res.json();
        if (responseJsonViewer) responseJsonViewer.innerText = JSON.stringify(data, null, 2);
      } catch (err) {
        if (responseStatusSpan) responseStatusSpan.innerText = "Status: Connection Failed";
        if (responseJsonViewer) responseJsonViewer.innerText = `Fetch Error: ${err.message}\nEnsure the development server is running.`;
      }
    });
  }
</script>
