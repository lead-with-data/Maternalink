            ) : (
              <div class="inline-flex items-center gap-1.5 px-3 py-1 bg-amber-500/10 backdrop-blur-md border border-amber-500/30 text-amber-700 rounded-full shadow-sm">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
                <span class="text-[9px] font-black uppercase tracking-widest" data-translate="dw-postgres">Local PostgreSQL Fail-safe Active</span>
              </div>
            )}
          </div>
          
          <h2 class="text-3xl font-light text-[#2c1d30] tracking-tight" style="font-family: 'Outfit', sans-serif;">
            Maternal Health <span class="font-extrabold text-[#9b6fa0]" id="cohort-header-title" data-translate="cohort-title">Unified Command & Surveillance</span>
          </h2>
          <p class="text-[11px] text-[#5c4a63] font-medium tracking-wide mt-1" data-translate="portal-subtitle">
            Supervising clinic patient cohorts, logging blood pressure/vitals telemetry, and resolving obstetric alerts.
          </p>
