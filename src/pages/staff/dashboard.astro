      "checkup-resp": "سانس کی رفتار",
      "checkup-height": "قد (میٹر)",
      "checkup-protein": "پیشاب میں پروٹین",
      "checkup-sugar-fasting": "نہار منہ شوگر (mg/dL)",
      "checkup-sugar-random": "رینڈم بلڈ شوگر (mg/dL)",
      "checkup-iron": "آئرن گولیوں کا باقاعدہ استعمال؟",
