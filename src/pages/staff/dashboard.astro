                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 00-2 2H7a2 2 0 002-2V7a2 2 0 00-2-2zM9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
              </svg>
            </a>
            <a href="#cohort-ledger" class="text-[#5c4a63] hover:text-[#c47c3a] transition-all" title="Cohort Ledger">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- ==================== HORIZONTAL OPERATIONAL STATS DOCK ==================== -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        
        <!-- Card 1: Assigned Cohort -->
        <div class="p-5 bg-white/70 backdrop-blur-xl border border-white/50 shadow-xl rounded-[28px] space-y-2">
          <div class="flex items-center justify-between">
            <span class="text-[9px] font-black text-[#765e82] uppercase tracking-widest block" data-translate="cohort-card">Unified Cohort</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-[#9b6fa0]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
          </div>
          <p class="text-4xl font-black text-[#2c1d30] font-mono leading-none">{totalMothers}</p>
          <p class="text-[10px] text-[#5c4a63] font-bold" data-translate="cohort-desc">Mothers registered under surveillance</p>
        </div>

        <!-- Card 2: Active Urgent Alerts -->
        <div class="p-5 bg-[#fcf8f2]/80 border border-[#ebdcd5] border-l-4 border-l-[#c47c3a] shadow-xl rounded-[28px] space-y-2">
          <div class="flex items-center justify-between">
            <span class="text-[9px] font-black text-[#c47c3a] uppercase tracking-widest block font-black" data-translate="risk-card">Active Alert Cases</span>
            <span class="flex h-2 w-2 relative">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-rose-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-rose-500"></span>
            </span>
          </div>
          <p class="text-4xl font-black text-[#c47c3a] font-mono leading-none">{activeReferralsCount}</p>
          <p class="text-[10px] text-[#5c4a63] font-bold" data-translate="risk-desc">Mothers flagged for critical specialist care</p>
        </div>

        <!-- Card 3: Checkups Logged -->
        <div class="p-5 bg-white/70 backdrop-blur-xl border border-white/50 shadow-xl rounded-[28px] space-y-2">
          <div class="flex items-center justify-between">
            <span class="text-[9px] font-black text-[#765e82] uppercase tracking-widest block" data-translate="checkup-card">Surveillance Encounters</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-[#c47c3a]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 00-2 2H7a2 2 0 002-2V7a2 2 0 00-2-2zM9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
            </svg>
          </div>
          <p class="text-4xl font-black text-[#2c1d30] font-mono leading-none">{totalVisits}</p>
          <p class="text-[10px] text-[#5c4a63] font-bold" data-translate="checkup-desc">Total clinical checkups logged</p>
        </div>

      </div>

      <!-- CLINICAL OPERATIONS NODE -->
      <div id="clinical-operations-node" class="space-y-8">

      <!-- Action status messages (Emerald / Rose capsules) -->
      {successMessage && (
        <div class="p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs flex items-center gap-3 max-w-3xl mx-auto shadow-sm">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-emerald-600 shrink-0" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span class="font-bold">{successMessage}</span>
        </div>
      )}

      {errorMessage && (
        <div class="p-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-800 text-xs flex items-center gap-3 max-w-3xl mx-auto shadow-sm">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-rose-600 shrink-0" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
          </svg>
          <span class="font-bold">{errorMessage}</span>
        </div>
      )}

      <!-- ==================== ACTIVE REFERRALS & RED ALERTS ==================== -->
      <section id="active-alerts" class="backdrop-blur-xl bg-white/75 border border-white/50 shadow-2xl rounded-[32px] p-8 space-y-6">
        <div class="flex items-center justify-between border-b border-[#2c2230]/8 pb-4">
          <h2 class="text-base font-black text-[#2c1d30] flex items-center gap-2.5">
            <span class="w-1.5 h-6 bg-rose-500 rounded-full"></span>
            <span data-translate="active-alerts-title">Active Emergency Referrals & Field Alerts</span>
          </h2>
          <span class="text-[9px] uppercase tracking-widest font-extrabold bg-[#1c1421] text-brand-sand py-1 px-3 rounded-full">
            Real-Time Cloud Feed
          </span>
        </div>

        {alerts.length === 0 ? (
          <div class="text-center py-12 text-[#765e82] text-xs font-bold uppercase tracking-wider">
            🎉 No active emergency referrals or red alerts. Expectant mothers are currently stable.
          </div>
        ) : (
          <div class="space-y-6">
            {alerts.map(alert => {
              const visit = alert.visit;
              const preg = visit.pregnancy;
              const patient = preg.patient;
              
              let cardColor = 'border-l-4 border-l-[#9b6fa0] bg-[#ebdbeb]/10';
              let tagColor = 'bg-[#9b6fa0]/10 text-[#9b6fa0] border-[#9b6fa0]/20';

              if (alert.severity === Severity.CRITICAL) {
                cardColor = 'border-l-4 border-l-red-500 bg-red-50/10';
                tagColor = 'bg-red-50 text-red-700 border-red-200';
              } else if (alert.severity === Severity.HIGH) {
                cardColor = 'border-l-4 border-l-[#c47c3a] bg-[#fdf5f2]/20';
                tagColor = 'bg-orange-50 text-orange-700 border-orange-200';
              }

              return (
                <div class={`border border-white/40 rounded-[28px] p-6 transition-all duration-300 relative bg-white/70 backdrop-blur-xl shadow-xl ${cardColor}`}>
                  
                  <div class="flex flex-wrap items-start justify-between gap-4 mb-4">
                    <div>
                      <div class="flex items-center gap-2.5">
                        <h3 class="text-base font-black text-[#2c1d30]">{patient.name}</h3>
                        <span class="text-xs text-[#765e82] font-semibold">(Age: {patient.age}, Locality: {patient.address && patient.address.startsWith('{') ? JSON.parse(patient.address).streetAddress : patient.address})</span>
                        <span class={`text-[9px] uppercase font-extrabold tracking-widest px-2 py-0.5 rounded-full border ${tagColor}`}>
                          {alert.severity}
                        </span>
                      </div>
                      <p class="text-xs text-[#9b6fa0] font-semibold mt-1">LMP: {new Date(preg.startDate).toLocaleDateString()} | EDD: {new Date(preg.expectedDueDate).toLocaleDateString()} | Gestational Age: {visit.gestationalWeeks} weeks</p>
                    </div>
                    <span class="text-[10px] font-mono text-slate-500 font-bold">{new Date(alert.createdAt).toLocaleString()}</span>
                  </div>

                  <!-- Clinical values overlay -->
                  <div class="grid grid-cols-2 sm:grid-cols-5 gap-4 p-4 bg-white/75 border border-white/40 rounded-xl text-center mb-4">
                    <div>
                      <p class="text-[9px] text-[#765e82] font-bold uppercase tracking-widest">Blood Pressure</p>
                      <p class="text-base font-extrabold font-mono text-[#2c1d30] mt-1">{visit.systolicBP}/{visit.diastolicBP} <span class="text-[9px] font-normal text-[#765e82]">mmHg</span></p>
                    </div>
                    <div>
                      <p class="text-[9px] text-[#765e82] font-bold uppercase tracking-widest">Hemoglobin</p>
                      <p class="text-base font-extrabold font-mono text-[#2c1d30] mt-1">{visit.hemoglobin} <span class="text-[9px] font-normal text-[#765e82]">g/dL</span></p>
                    </div>
                    <div>
                      <p class="text-[9px] text-[#765e82] font-bold uppercase tracking-widest">Fetal Heart Rate</p>
                      <p class="text-base font-extrabold font-mono text-[#2c1d30] mt-1">{visit.fetalHeartRate || 'N/A'} <span class="text-[9px] font-normal text-[#765e82]">bpm</span></p>
                    </div>
                    <div>
                      <p class="text-[9px] text-[#765e82] font-bold uppercase tracking-widest">Weight</p>
                      <p class="text-base font-extrabold font-mono text-[#2c1d30] mt-1">{visit.weight} <span class="text-[9px] font-normal text-[#765e82]">kg</span></p>
                    </div>
                    <div class="col-span-2 sm:col-span-1">
                      <p class="text-[9px] text-[#765e82] font-bold uppercase tracking-widest">Symptoms</p>
                      <p class="text-xs text-[#2c1d30] font-bold mt-1 truncate">
                        {visit.symptoms && visit.symptoms.startsWith('{') ? parseCheckupSymptoms(visit.symptoms).checklist.join(', ') : (visit.symptoms || 'None')}
                      </p>
                    </div>
                  </div>

                  <!-- Voice transcript and AI advice -->
                  <div class="space-y-4 mb-5 text-xs">
                    {visit.voiceTranscript && (
                      <div>
                        <p class="text-[#765e82] font-bold tracking-wider uppercase text-[9px] mb-1">Spoken Note / Case Transcript:</p>
                        <div class="p-3.5 bg-white/70 border border-white/40 rounded-xl text-[#5c4a63] italic font-medium leading-relaxed">
                          "{visit.voiceTranscript}"
                        </div>
                      </div>
                    )}
                    <div>
                      <p class="text-[#9b6fa0] font-bold tracking-wider uppercase text-[9px] mb-1">Clinical Decision Support & Urgency Details:</p>
                      <div class="p-4 bg-[#9b6fa0]/5 border border-[#9b6fa0]/15 rounded-xl text-[#2c1d30] leading-relaxed">
                        {alert.message}
                        <div class="mt-3 text-[10px] text-[#765e82] border-t border-[#2c2230]/8 pt-2 flex items-center justify-between">
                          <span class="font-semibold">Clinical Risk Assessment Score: <strong class="text-[#c47c3a] font-mono">{visit.riskScore}%</strong></span>
                          <span class="font-semibold">Recommended Actions: <strong class="text-[#c47c3a] font-mono">{visit.medications || 'Standard Care'}</strong></span>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- Resolve action form -->
                  <form method="POST" class="border-t border-[#2c2230]/8 pt-4">
                    <input type="hidden" name="action" value="resolve" />
                    <input type="hidden" name="alertId" value={alert.id} />
                    
                    <div class="flex flex-col sm:flex-row gap-3">
                      <input 
                        type="text" 
                        name="notes" 
                        required 
                        data-translate-placeholder="notes-placeholder"
                        placeholder="Type clinical action outcome (e.g. Admitted Zainab Bibi, administered Magnesium Sulfate IV, monitored vitals)" 
                        class="flex-1 py-2.5 px-4 bg-white border border-[#2c2230]/10 focus:border-[#9b6fa0] rounded-xl text-[#2c1d30] text-xs focus:outline-none placeholder-slate-400 transition-all focus:ring-1 focus:ring-[#9b6fa0]/30"
                      />
                      <button 
                        type="submit" 
                        data-translate="resolve-submit"
                        class="py-2.5 px-5 bg-[#1c1421] hover:bg-[#2c2033] text-white font-extrabold text-xs tracking-wider uppercase rounded-xl shadow-sm transition-all shrink-0 cursor-pointer"
                      >
                        Resolve Alert & Update Record
                      </button>
                    </div>
                  </form>

                </div>
              );
            })}
          </div>
        )}
      </section>

      <!-- ==================== INTERACTIVE DATA WORKSPACE ==================== -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">

        <!-- Form 1: Register Expectant Mother -->
        <div id="register" class="backdrop-blur-xl bg-white/75 border border-white/50 shadow-2xl rounded-[32px] p-8">
          <div class="flex items-center gap-2.5 mb-6 border-b border-[#2c2230]/8 pb-4">
            <span class="w-1.5 h-6 bg-[#9b6fa0] rounded-full"></span>
            <h3 class="text-base font-black text-[#2c1d30]" data-translate="reg-title">Register New Expectant Mother</h3>
          </div>

          <form method="POST" class="space-y-4">
            <input type="hidden" name="action" value="register-mother" />

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-[9px] font-black text-[#765e82] uppercase tracking-widest mb-1.5" data-translate="reg-name">Mother Full Name *</label>
                <input type="text" name="name" required data-translate-placeholder="mother-placeholder" placeholder="e.g. Fatima Bai" class="w-full text-xs font-semibold px-4 py-2.5 rounded-xl border border-[#ebdcd5] bg-white/50 text-[#2c1d30] focus:bg-white focus:ring-2 focus:ring-[#9b6fa0] outline-none transition-all" />
              </div>
              <div>
                <label class="block text-[9px] font-black text-[#765e82] uppercase tracking-widest mb-1.5" data-translate="reg-mobile">Mobile Number</label>
                <input type="text" name="mobile" data-translate-placeholder="mobile-placeholder" placeholder="e.g. 03001234567" class="w-full text-xs font-semibold px-4 py-2.5 rounded-xl border border-[#ebdcd5] bg-white/50 text-[#2c1d30] focus:bg-white focus:ring-2 focus:ring-[#9b6fa0] outline-none transition-all" />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-[9px] font-black text-[#765e82] uppercase tracking-widest mb-1.5" data-translate="reg-cnic">CNIC / ID Card</label>
                <input type="text" name="cnic" data-translate-placeholder="cnic-placeholder" placeholder="e.g. 44301-1234567-8" class="w-full text-xs font-semibold px-4 py-2.5 rounded-xl border border-[#ebdcd5] bg-white/50 text-[#2c1d30] focus:bg-white focus:ring-2 focus:ring-[#9b6fa0] outline-none transition-all" />
              </div>
              <div>
                <label class="block text-[9px] font-black text-[#765e82] uppercase tracking-widest mb-1.5" data-translate="reg-age">Mother Age *</label>
                <input type="number" name="age" required min="12" max="60" data-translate-placeholder="age-placeholder" placeholder="e.g. 26" class="w-full text-xs font-semibold px-4 py-2.5 rounded-xl border border-[#ebdcd5] bg-white/50 text-[#2c1d30] focus:bg-white focus:ring-2 focus:ring-[#9b6fa0] outline-none transition-all" />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-[9px] font-black text-[#765e82] uppercase tracking-widest mb-1.5" data-translate="reg-address">Address / Village Locality</label>
                <input type="text" name="address" data-translate-placeholder="address-placeholder" placeholder="e.g. Village Mithrio, Diplo" class="w-full text-xs font-semibold px-4 py-2.5 rounded-xl border border-[#ebdcd5] bg-white/50 text-[#2c1d30] focus:bg-white focus:ring-2 focus:ring-[#9b6fa0] outline-none transition-all" />
              </div>
              <div>
                <label class="block text-[9px] font-black text-[#765e82] uppercase tracking-widest mb-1.5" data-translate="reg-family">Husband/Family Phone *</label>
                <input type="text" name="familyContact" required data-translate-placeholder="family-placeholder" placeholder="e.g. 03017654321" class="w-full text-xs font-semibold px-4 py-2.5 rounded-xl border border-[#ebdcd5] bg-white/50 text-[#2c1d30] focus:bg-white focus:ring-2 focus:ring-[#9b6fa0] outline-none transition-all" />
              </div>
            </div>

            <!-- Socio-demographics & phone ownership -->
            <div class="grid grid-cols-3 gap-3">
              <div>
                <label class="block text-[8px] font-black text-[#765e82] uppercase tracking-widest mb-1.5" data-translate="reg-edu">Education</label>
                <select name="education" class="w-full text-xs font-semibold px-3 py-2.5 rounded-xl border border-[#ebdcd5] bg-white/50 text-[#2c1d30] outline-none focus:bg-white">
                  <option value="None">None</option>
                  <option value="Primary">Primary</option>
                  <option value="Secondary">Secondary</option>
                  <option value="Higher">Higher</option>
                </select>
              </div>
              <div>
                <label class="block text-[8px] font-black text-[#765e82] uppercase tracking-widest mb-1.5" data-translate="reg-soc">Socioeconomic</label>
                <select name="socioeconomic" class="w-full text-xs font-semibold px-3 py-2.5 rounded-xl border border-[#ebdcd5] bg-white/50 text-[#2c1d30] outline-none focus:bg-white">
                  <option value="Low">Low Tier</option>
                  <option value="Middle">Middle Tier</option>
                  <option value="High">High Tier</option>
                </select>
              </div>
              <div>
                <label class="block text-[8px] font-black text-[#765e82] uppercase tracking-widest mb-1.5" data-translate="reg-phone">Phone Owner</label>
                <select name="phoneOwnership" class="w-full text-xs font-semibold px-3 py-2.5 rounded-xl border border-[#ebdcd5] bg-white/50 text-[#2c1d30] outline-none focus:bg-white">
                  <option value="Self">Self Owned</option>
                  <option value="Husband">Husband's</option>
                  <option value="Family">Shared Family</option>
                  <option value="None">No Phone</option>
                </select>
              </div>
            </div>

            <!-- Obstetric background counters -->
            <div class="bg-white/40 border border-[#ebdcd5]/70 rounded-xl p-3 space-y-3">
              <span class="block text-[8px] font-black text-[#765e82] uppercase tracking-widest">Obstetric History Background</span>
              <div class="grid grid-cols-4 gap-2">
                <div>
                  <label class="block text-[7.5px] font-bold text-[#765e82] mb-1">Miscarriages</label>
                  <input type="number" name="miscarriages" min="0" value="0" class="w-full text-xs font-semibold p-2 rounded-lg border border-[#ebdcd5] bg-white text-center" />
                </div>
                <div>
                  <label class="block text-[7.5px] font-bold text-[#765e82] mb-1">Stillbirths</label>
                  <input type="number" name="stillbirths" min="0" value="0" class="w-full text-xs font-semibold p-2 rounded-lg border border-[#ebdcd5] bg-white text-center" />
                </div>
                <div>
                  <label class="block text-[7.5px] font-bold text-[#765e82] mb-1">C-Sections</label>
                  <input type="number" name="cSections" min="0" value="0" class="w-full text-xs font-semibold p-2 rounded-lg border border-[#ebdcd5] bg-white text-center" />
                </div>
                <div>
                  <label class="block text-[7.5px] font-bold text-[#765e82] mb-1">Neonatal Deaths</label>
                  <input type="number" name="neonatalDeaths" min="0" value="0" class="w-full text-xs font-semibold p-2 rounded-lg border border-[#ebdcd5] bg-white text-center" />
                </div>
              </div>
              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label class="block text-[8px] font-black text-[#765e82] uppercase tracking-widest mb-1">Premature Births</label>
                  <input type="number" name="prematureBirths" min="0" value="0" class="w-full text-xs font-semibold px-3 py-2 rounded-lg border border-[#ebdcd5] bg-white" />
                </div>
                <div>
                  <label class="block text-[8px] font-black text-[#765e82] uppercase tracking-widest mb-1">Postpartum Hemorrhage?</label>
                  <select name="historyHemorrhage" class="w-full text-xs font-semibold px-3 py-2 rounded-lg border border-[#ebdcd5] bg-white">
                    <option value="No">No History</option>
                    <option value="Yes">Yes, High Risk</option>
                  </select>
                </div>
              </div>
            </div>

            <!-- Public health determinatives -->
            <div class="grid grid-cols-3 gap-3">
              <div>
                <label class="block text-[8px] font-black text-[#765e82] uppercase tracking-widest mb-1">Hospital (km)</label>
                <input type="number" step="0.1" name="hospitalDistance" value="5.0" class="w-full text-xs font-semibold px-3 py-2 rounded-xl border border-[#ebdcd5] bg-white/50" />
              </div>
              <div>
                <label class="block text-[8px] font-black text-[#765e82] uppercase tracking-widest mb-1">Clean Water?</label>
                <select name="cleanWaterAccess" class="w-full text-xs font-semibold px-3 py-2 rounded-xl border border-[#ebdcd5] bg-white/50">
                  <option value="Yes">Yes</option>
                  <option value="No">No</option>
                </select>
              </div>
              <div>
                <label class="block text-[8px] font-black text-[#765e82] uppercase tracking-widest mb-1">Nutrition</label>
                <select name="nutritionAccess" class="w-full text-xs font-semibold px-3 py-2 rounded-xl border border-[#ebdcd5] bg-white/50">
                  <option value="Good">Good</option>
                  <option value="Average" selected>Average</option>
                  <option value="Poor">Poor</option>
                </select>
              </div>
            </div>

            <div class="grid grid-cols-3 gap-3 pt-2">
              <div>
                <label class="block text-[8px] font-black text-[#765e82] uppercase tracking-widest mb-1.5" data-translate="reg-gest">Gestational Age *</label>
                <input type="number" name="gestationalWeeks" required min="1" max="42" data-translate-placeholder="weeks-placeholder" placeholder="Weeks" class="w-full text-xs font-semibold px-4 py-2.5 rounded-xl border border-[#ebdcd5] bg-white/50 text-[#2c1d30] focus:bg-white focus:ring-2 focus:ring-[#9b6fa0] outline-none transition-all" />
              </div>
              <div>
                <label class="block text-[8px] font-black text-[#765e82] uppercase tracking-widest mb-1.5" data-translate="reg-gravida">Gravida (Pregnancies)</label>
                <input type="number" name="gravida" min="1" max="20" data-translate-placeholder="gravida-placeholder" placeholder="e.g. 2" class="w-full text-xs font-semibold px-4 py-2.5 rounded-xl border border-[#ebdcd5] bg-white/50 text-[#2c1d30] focus:bg-white focus:ring-2 focus:ring-[#9b6fa0] outline-none transition-all" />
              </div>
              <div>
                <label class="block text-[8px] font-black text-[#765e82] uppercase tracking-widest mb-1.5" data-translate="reg-para">Para (Live Births)</label>
                <input type="number" name="para" min="0" max="20" data-translate-placeholder="para-placeholder" placeholder="e.g. 1" class="w-full text-xs font-semibold px-4 py-2.5 rounded-xl border border-[#ebdcd5] bg-white/50 text-[#2c1d30] focus:bg-white focus:ring-2 focus:ring-[#9b6fa0] outline-none transition-all" />
              </div>
            </div>

            <button type="submit" data-translate="reg-submit" class="w-full py-3 bg-[#1c1421] hover:bg-[#2c2033] text-white text-[10px] font-black uppercase tracking-widest rounded-xl transition-all shadow-md cursor-pointer mt-4">
              Register Expectant Patient
            </button>
          </form>
        </div>

        <!-- Form 2: Record Biometric / Visit Checkup -->
        <div id="checkup" class="backdrop-blur-xl bg-[#fcf8f2]/75 border border-white/50 shadow-2xl rounded-[32px] p-8">
          <div class="flex items-center gap-2.5 mb-6 border-b border-[#2c2230]/8 pb-4">
            <span class="w-1.5 h-6 bg-[#c47c3a] rounded-full"></span>
            <h3 class="text-base font-black text-[#2c1d30]" data-translate="checkup-title">Record Mother Vitals & Checkup</h3>
          </div>

          {activePregnancies.length === 0 ? (
            <div class="text-center py-12 text-xs font-semibold text-[#765e82]">
              ⚠️ Please register at least one mother first to record biometric health checkups.
            </div>
          ) : (
            <form method="POST" class="space-y-4">
              <input type="hidden" name="action" value="record-checkup" />

              <div>
                <label class="block text-[9px] font-black text-[#765e82] uppercase tracking-widest mb-1.5" data-translate="checkup-select">Select Expectant Mother *</label>
                <select name="pregnancyId" required class="w-full text-xs font-semibold px-4 py-2.5 rounded-xl border border-[#ebdcd5] bg-white/50 text-[#2c1d30] outline-none transition-all focus:bg-white">
                  {patients.map(p => {
                    const activeP = p.pregnancies.find(pr => pr.isActive);
                    if (!activeP) return null;
                    const latestVisit = activeP.visits[0];
                    const riskText = latestVisit ? ` | Risk: ${latestVisit.riskCategory}` : '';
                    return (
                      <option value={activeP.id}>
                        {p.name} (Age {p.age}){riskText}
                      </option>
                    );
                  })}
                </select>
              </div>

              <!-- ==================== INTERACTIVE LONGITUDINAL HEALTH PANEL ==================== -->
              <div id="longitudinalPanel" class="hidden bg-[#ebdcd5]/20 border border-[#ebdcd5]/80 rounded-2xl p-4.5 space-y-2.5 transition-all">
                <span class="block text-[8px] font-black text-[#9b6fa0] uppercase tracking-widest">
                  🔗 Longitudinal Clinical Intelligence (Time Series Trends)
                </span>
                <div class="space-y-1.5 text-xs text-[#2c1d30]">
                  <p class="text-[10px] text-[#5c4a63]" id="longitudinalTimeline"></p>
                  <p class="text-[10px] text-[#5c4a63]">
                    <strong>Clinical BP Trajectory:</strong> <span class="font-mono font-bold text-[#c47c3a]" id="longitudinalBPTrend"></span>
                  </p>
                  <p class="text-[10px] text-[#5c4a63]">
                    <strong>Anemia Progression (Hb):</strong> <span class="font-mono font-bold text-[#c47c3a]" id="longitudinalAnemia"></span>
                  </p>
                  <p class="text-[10px] text-[#5c4a63]">
                    <strong>Previously Advised Medicines:</strong> <span class="font-medium text-[#765e82]" id="longitudinalMeds"></span>
                  </p>
                  <p class="text-[10px] text-[#5c4a63]">
                    <strong>AI Longitudinal Prognosis (Gemma):</strong> <span class="font-medium text-emerald-800" id="longitudinalAIPrediction"></span>
                  </p>
                </div>
                <div class="border-t border-[#ebdcd5]/60 pt-2" id="longitudinalMetadata"></div>
              </div>

              <div class="grid grid-cols-3 gap-3">
                <div>
                  <label class="block text-[8px] font-black text-[#765e82] uppercase tracking-widest mb-1.5" data-translate="checkup-gest">Gest Weeks *</label>
                  <input type="number" name="gestationalWeeks" required min="1" max="42" placeholder="e.g. 24" class="w-full text-xs font-semibold px-4 py-2.5 rounded-xl border border-[#ebdcd5] bg-white/50 text-[#2c1d30] focus:bg-white focus:ring-2 focus:ring-[#9b6fa0] outline-none transition-all" />
                </div>
                <div>
                  <label class="block text-[8px] font-black text-[#765e82] uppercase tracking-widest mb-1.5" data-translate="checkup-sys">BP Systolic *</label>
                  <input type="number" name="systolicBP" required placeholder="e.g. 120" class="w-full text-xs font-semibold px-4 py-2.5 rounded-xl border border-[#ebdcd5] bg-white/50 text-[#2c1d30] focus:bg-white focus:ring-2 focus:ring-[#9b6fa0] outline-none transition-all" />
                </div>
                <div>
                  <label class="block text-[8px] font-black text-[#765e82] uppercase tracking-widest mb-1.5" data-translate="checkup-dias">BP Diastolic *</label>
                  <input type="number" name="diastolicBP" required placeholder="e.g. 80" class="w-full text-xs font-semibold px-4 py-2.5 rounded-xl border border-[#ebdcd5] bg-white/50 text-[#2c1d30] focus:bg-white focus:ring-2 focus:ring-[#9b6fa0] outline-none transition-all" />
                </div>
              </div>

              <!-- Vitals Core: Pulse, Temperature, SpO2 -->
              <div class="grid grid-cols-3 gap-3">
                <div>
                  <label class="block text-[8px] font-black text-[#765e82] uppercase tracking-widest mb-1.5" data-translate="checkup-pulse">Pulse Rate (BPM) *</label>
                  <input type="number" name="pulse" required value="72" min="40" max="200" class="w-full text-xs font-semibold px-4 py-2.5 rounded-xl border border-[#ebdcd5] bg-white/50 text-[#2c1d30] outline-none focus:bg-white" />
                </div>
                <div>
                  <label class="block text-[8px] font-black text-[#765e82] uppercase tracking-widest mb-1.5" data-translate="checkup-temp">Temp (°F) *</label>
                  <input type="number" step="0.1" name="temperature" required value="98.6" min="94" max="108" class="w-full text-xs font-semibold px-4 py-2.5 rounded-xl border border-[#ebdcd5] bg-white/50 text-[#2c1d30] outline-none focus:bg-white" />
                </div>
                <div>
                  <label class="block text-[8px] font-black text-[#765e82] uppercase tracking-widest mb-1.5" data-translate="checkup-spO2">Oxygen Sat (%) *</label>
                  <input type="number" name="oxygenSat" required value="98" min="50" max="100" class="w-full text-xs font-semibold px-4 py-2.5 rounded-xl border border-[#ebdcd5] bg-white/50 text-[#2c1d30] outline-none focus:bg-white" />
                </div>
              </div>

              <div class="grid grid-cols-3 gap-3">
                <div>
                  <label class="block text-[8px] font-black text-[#765e82] uppercase tracking-widest mb-1.5" data-translate="checkup-hb">HB (g/dL) *</label>
                  <input type="number" step="0.1" name="hemoglobin" required placeholder="e.g. 11.5" class="w-full text-xs font-semibold px-4 py-2.5 rounded-xl border border-[#ebdcd5] bg-white/50 text-[#2c1d30] focus:bg-white focus:ring-2 focus:ring-[#9b6fa0] outline-none transition-all" />
                </div>
                <div>
                  <label class="block text-[8px] font-black text-[#765e82] uppercase tracking-widest mb-1.5" data-translate="checkup-weight">Weight (kg) *</label>
                  <input type="number" step="0.1" name="weight" required placeholder="e.g. 62" class="w-full text-xs font-semibold px-4 py-2.5 rounded-xl border border-[#ebdcd5] bg-white/50 text-[#2c1d30] focus:bg-white focus:ring-2 focus:ring-[#9b6fa0] outline-none transition-all" />
                </div>
                <div>
                  <label class="block text-[8px] font-black text-[#765e82] uppercase tracking-widest mb-1.5" data-translate="checkup-fhr">FHR (BPM)</label>
                  <input type="number" name="fetalHeartRate" placeholder="e.g. 140" class="w-full text-xs font-semibold px-4 py-2.5 rounded-xl border border-[#ebdcd5] bg-white/50 text-[#2c1d30] focus:bg-white focus:ring-2 focus:ring-[#9b6fa0] outline-none transition-all" />
                </div>
              </div>

              <!-- Lab diagnostics and height (BMI auto-calc) -->
              <div class="grid grid-cols-3 gap-3">
                <div>
                  <label class="block text-[8px] font-black text-[#765e82] uppercase tracking-widest mb-1.5" data-translate="checkup-resp">Resp Rate (breaths)</label>
                  <input type="text" name="respiratoryRate" placeholder="N/A" class="w-full text-xs font-semibold px-4 py-2.5 rounded-xl border border-[#ebdcd5] bg-white/50 text-[#2c1d30] outline-none focus:bg-white" />
                </div>
                <div>
                  <label class="block text-[8px] font-black text-[#765e82] uppercase tracking-widest mb-1.5" data-translate="checkup-height">Height (meters)</label>
                  <input type="text" name="height" placeholder="N/A" class="w-full text-xs font-semibold px-4 py-2.5 rounded-xl border border-[#ebdcd5] bg-white/50 text-[#2c1d30] outline-none focus:bg-white" />
                </div>
                <div>
                  <label class="block text-[8px] font-black text-[#765e82] uppercase tracking-widest mb-1.5" data-translate="checkup-protein">Urine Protein</label>
                  <select name="urineProtein" class="w-full text-xs font-semibold px-3 py-2.5 rounded-xl border border-[#ebdcd5] bg-white/50 text-[#2c1d30] outline-none focus:bg-white">
                    <option value="None">None</option>
                    <option value="Trace">Trace</option>
                    <option value="+">+</option>
                    <option value="++">++</option>
                    <option value="+++">+++</option>
                  </select>
                </div>
              </div>

              <div id="bmiDisplay" class="text-[10px] font-bold tracking-wide text-right pr-2"></div>

              <!-- Glucose glycemia testing -->
              <div class="grid grid-cols-2 gap-4">
                <div>
                  <label class="block text-[8px] font-black text-[#765e82] uppercase tracking-widest mb-1.5" data-translate="checkup-sugar-fasting">Fasting Blood Sugar (mg/dL)</label>
                  <input type="text" name="fastingSugar" placeholder="N/A" class="w-full text-xs font-semibold px-4 py-2.5 rounded-xl border border-[#ebdcd5] bg-white/50" />
                </div>
                <div>
                  <label class="block text-[8px] font-black text-[#765e82] uppercase tracking-widest mb-1.5" data-translate="checkup-sugar-random">Random Blood Sugar (mg/dL)</label>
                  <input type="text" name="randomSugar" placeholder="N/A" class="w-full text-xs font-semibold px-4 py-2.5 rounded-xl border border-[#ebdcd5] bg-white/50" />
                </div>
              </div>

              <!-- Treatment behavior & tablet adherence -->
              <div class="grid grid-cols-2 gap-4">
                <div>
                  <label class="block text-[8px] font-black text-[#765e82] uppercase tracking-widest mb-1.5" data-translate="checkup-iron">Iron Tablet Adherence?</label>
                  <select name="ironAdherence" class="w-full text-xs font-semibold px-3 py-2.5 rounded-xl border border-[#ebdcd5] bg-white/50 text-[#2c1d30]">
                    <option value="Yes">Yes, Compliant</option>
                    <option value="No">No, Missed</option>
                  </select>
                </div>
                <div>
                  <label class="block text-[8px] font-black text-[#765e82] uppercase tracking-widest mb-1.5" data-translate="checkup-missed">Missed Other Med Doses?</label>
                  <select name="missedDoses" class="w-full text-xs font-semibold px-3 py-2.5 rounded-xl border border-[#ebdcd5] bg-white/50 text-[#2c1d30]">
                    <option value="No">No Misses</option>
                    <option value="Yes">Yes, Irregular</option>
                  </select>
                </div>
              </div>

              <div>
                <label class="block text-[9px] font-black text-[#765e82] uppercase tracking-widest mb-1.5" data-translate="checkup-danger">Obstetric Danger Symptoms</label>
                <div class="grid grid-cols-2 gap-2 bg-white/40 border border-[#ebdcd5]/70 rounded-xl p-3">
                  <label class="flex items-center gap-2 text-[10px] font-semibold text-[#2c1d30] cursor-pointer">
                    <input type="checkbox" name="symptoms" value="Severe Headache" class="rounded border-[#ebdcd5] text-[#9b6fa0] focus:ring-[#9b6fa0]" />
                    Severe Headache
                  </label>
                  <label class="flex items-center gap-2 text-[10px] font-semibold text-[#2c1d30] cursor-pointer">
                    <input type="checkbox" name="symptoms" value="Vaginal Bleeding" class="rounded border-[#ebdcd5] text-[#9b6fa0] focus:ring-[#9b6fa0]" />
                    Vaginal Bleeding
                  </label>
                  <label class="flex items-center gap-2 text-[10px] font-semibold text-[#2c1d30] cursor-pointer">
                    <input type="checkbox" name="symptoms" value="Swollen Hands/Face" class="rounded border-[#ebdcd5] text-[#9b6fa0] focus:ring-[#9b6fa0]" />
                    Swollen Hands/Face
                  </label>
                  <label class="flex items-center gap-2 text-[10px] font-semibold text-[#2c1d30] cursor-pointer">
                    <input type="checkbox" name="symptoms" value="Blurry Vision" class="rounded border-[#ebdcd5] text-[#9b6fa0] focus:ring-[#9b6fa0]" />
                    Blurry Vision
                  </label>
                  <label class="flex items-center gap-2 text-[10px] font-semibold text-[#2c1d30] cursor-pointer">
                    <input type="checkbox" name="symptoms" value="Fever" class="rounded border-[#ebdcd5] text-[#9b6fa0] focus:ring-[#9b6fa0]" />
                    Fever
                  </label>
                  <label class="flex items-center gap-2 text-[10px] font-semibold text-[#2c1d30] cursor-pointer">
                    <input type="checkbox" name="symptoms" value="Decreased Fetal Movement" class="rounded border-[#ebdcd5] text-[#9b6fa0] focus:ring-[#9b6fa0]" />
                    Decreased Movement
                  </label>
                </div>
              </div>

              <!-- Spoken Note Transcript -->
              <div>
                <label class="block text-[9px] font-black text-[#765e82] uppercase tracking-widest mb-1" data-translate="checkup-voice">
                  Voice Note / Case Transcript
                </label>
                <div class="relative">
                  <textarea name="voiceTranscript" rows="2" placeholder="e.g. Patient has severe headache and swelling in legs for two days." class="w-full text-xs font-semibold px-4 py-2.5 rounded-xl border border-[#ebdcd5] bg-white/50 text-[#2c1d30] focus:bg-white focus:ring-2 focus:ring-[#9b6fa0] outline-none transition-all pr-12"></textarea>
                  <div class="absolute right-3.5 top-3 w-7 h-7 bg-[#9b6fa0]/10 border border-[#9b6fa0]/25 rounded-full flex items-center justify-center text-[#9b6fa0]">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
                    </svg>
                  </div>
                </div>
                <p class="text-[8.5px] text-[#765e82] mt-1 font-semibold">Voice transcription processes clinical remarks instantly to support precision triage.</p>
              </div>

              <button type="submit" data-translate="checkup-submit" class="w-full py-3 bg-[#c47c3a] hover:bg-[#b06f33] text-white text-[10px] font-black uppercase tracking-widest rounded-xl transition-all shadow-md cursor-pointer mt-4">
                Record Biometrics & Analyze Risk
              </button>
            </form>
          )}
        </div>

      </div>

      <!-- ==================== COHORT PATIENT LEDGER ==================== -->
      <section id="cohort-ledger" class="backdrop-blur-xl bg-white/75 border border-white/50 shadow-2xl rounded-[32px] p-8">
        <div class="flex items-center justify-between mb-6 border-b border-[#2c2230]/8 pb-4">
          <h2 class="text-base font-black text-[#2c1d30] flex items-center gap-2.5">
            <span class="w-1.5 h-6 bg-[#9b6fa0] rounded-full"></span>
            <span data-translate="cohort-ledger-title">Patient Ledger & Clinical Outcomes</span>
          </h2>
          <span class="text-[9px] uppercase tracking-widest font-extrabold bg-[#1c1421] text-brand-sand py-1 px-3 rounded-full">
            Active Care Ledger
          </span>
        </div>

        {patients.length === 0 ? (
          <div class="text-center py-12 text-[#765e82] text-xs font-bold uppercase tracking-wider">
            ⚠️ No patients are registered in this cohort yet. Use the registration panel above.
          </div>
        ) : (
          <div class="overflow-x-auto">
            <table class="w-full border-collapse text-left">
              <thead>
                <tr class="border-b border-[#2c2230]/8 text-[#765e82]">
                  <th class="py-3 px-4 text-[9px] font-black uppercase tracking-widest">Expectant Mother</th>
                  <th class="py-3 px-4 text-[9px] font-black uppercase tracking-widest">Age / Mobile</th>
                  <th class="py-3 px-4 text-[9px] font-black uppercase tracking-widest">Village Location</th>
                  <th class="py-3 px-4 text-[9px] font-black uppercase tracking-widest">Active Gestation</th>
                  <th class="py-3 px-4 text-[9px] font-black uppercase tracking-widest">Latest Checkup Vitals</th>
                  <th class="py-3 px-4 text-[9px] font-black uppercase tracking-widest">Clinical Risk Assessment</th>
                  <th class="py-3 px-4 text-[9px] font-black uppercase tracking-widest text-center">Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-[#2c2230]/4">
                {patients.map(p => {
                  const activeP = p.pregnancies.find(pr => pr.isActive);
                  const latestVisit = activeP?.visits[0];

                  let riskBadgeColor = 'bg-emerald-50 text-emerald-800 border-emerald-200';
                  if (latestVisit?.riskCategory === RiskCategory.HIGH) riskBadgeColor = 'bg-amber-50 text-amber-800 border-amber-200';
                  if (latestVisit?.riskCategory === RiskCategory.CRITICAL) riskBadgeColor = 'bg-rose-50 text-rose-800 border-rose-200';

                  const checkupDetail = latestVisit ? parseCheckupSymptoms(latestVisit.symptoms) : null;

                  return (
                    <tr class="hover:bg-white/40 transition-colors text-xs cursor-pointer" onclick={`toggleRowExpansion('${p.id}')`}>
                      <td class="py-4 px-4">
                        <div class="font-extrabold text-[#2c1d30] text-xs">{p.name}</div>
                        {p.metadata.education && (
                          <span class="inline-block text-[7.5px] font-bold bg-[#9b6fa0]/10 text-[#9b6fa0] px-1.5 py-0.5 rounded-full mt-1">
                            Edu: {p.metadata.education}
                          </span>
                        )}
                        {p.lhw && (
                          <span class="inline-block text-[7.5px] font-bold bg-[#c47c3a]/10 text-[#c47c3a] px-1.5 py-0.5 rounded-full mt-1 ml-1">
                            LHW: {p.lhw.name}
                          </span>
                        )}
                        <div class="text-[9px] text-[#765e82] font-mono mt-0.5">CNIC: {p.cnic || 'N/A'}</div>
                      </td>
                      <td class="py-4 px-4 text-xs font-semibold text-[#5c4a63]">
                        <div>Age {p.age}</div>
                        <div class="text-[9.5px] mt-0.5">{p.mobile || 'No Mobile'}</div>
                      </td>
                      <td class="py-4 px-4 text-xs font-semibold text-[#5c4a63]">
                        <div>{p.streetAddress || 'Tharparkar District'}</div>
                        {p.metadata.familyContact && (
                          <div class="text-[8px] text-[#765e82] mt-0.5">Fam: {p.metadata.familyContact}</div>
                        )}
                      </td>
                      <td class="py-4 px-4">
                        {activeP ? (
                          <div>
                            <span class="text-xs font-extrabold text-[#2c1d30]">{latestVisit ? latestVisit.gestationalWeeks : 20} Weeks</span>
                            <span class="block text-[8px] text-[#765e82] font-semibold mt-0.5">
                              G{activeP.gravida} P{activeP.parity} | C-sec: {p.metadata.cSections || 0}
                            </span>
                          </div>
                        ) : (
                          <span class="text-[9px] text-[#765e82] font-bold">No Active Pregnancy</span>
                        )}
                      </td>
                      <td class="py-4 px-4">
                        {latestVisit ? (
                          <div class="space-y-0.5">
                            <div class="text-xs font-extrabold text-[#2c1d30] flex items-center gap-1.5">
                              <span>BP: {latestVisit.systolicBP}/{latestVisit.diastolicBP}</span>
                              <span class="text-[#ebdcd5]">|</span>
                              <span>HB: {latestVisit.hemoglobin} g/dL</span>
                            </div>
                            {checkupDetail && (
                              <div class="text-[8.5px] text-[#765e82] font-medium leading-none space-y-0.5">
                                <p>Pulse: {checkupDetail.pulse || 'N/A'} bpm | SpO2: {checkupDetail.oxygenSat || 'N/A'}% | Temp: {checkupDetail.temperature || 'N/A'}°F</p>
                                <p>Urine Prot: {checkupDetail.urineProtein || 'None'} | Iron Adh: {checkupDetail.ironAdherence || 'Yes'}</p>
                              </div>
                            )}
                          </div>
                        ) : (
                          <span class="text-[9px] text-[#765e82] font-semibold italic">No checkup recorded yet</span>
                        )}
                      </td>
                      <td class="py-4 px-4 text-center">
                        <button 
                          type="button"
                          class="px-3 py-1.5 rounded-xl bg-[#9b6fa0]/10 hover:bg-[#9b6fa0]/20 text-[#9b6fa0] text-[9.5px] font-black uppercase tracking-wider transition-all cursor-pointer flex items-center gap-1 mx-auto font-sans"
                          onclick={`event.stopPropagation(); toggleRowExpansion('${p.id}')`}
                          id={`btn-exp-${p.id}`}
                        >
                          Details
                          <svg id={`chevron-${p.id}`} xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                          </svg>
                        </button>
                      </td>
                    </tr>
                    
                    <tr id={`details-${p.id}`} class="hidden bg-[#ebdcd5]/10 border-t border-[#ebdcd5]/40 text-xs">
                      <td colspan="7" class="py-5 px-6">
                        <div class="space-y-4 animate-fade-in text-[#2c1d30]">
                          <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 pb-2 border-b border-[#2c2230]/5">
                            <div class="flex items-center gap-2">
                              <span class="w-1.5 h-4 bg-[#9b6fa0] rounded-full"></span>
                              <span class="font-extrabold text-[10px] text-[#9b6fa0] uppercase tracking-wider">AI Clinical Prognosis & Full History (Gemma)</span>
                            </div>
                            <span class="text-[8.5px] font-mono text-[#765e82] bg-white/60 px-2 py-0.5 rounded-full border border-slate-200">
                              Patient UID: {p.id.substring(0, 8)}...
                            </span>
                          </div>
                          
                          {latestVisit?.aiPrediction ? (
                            <div class="bg-white/80 border border-[#ebdcd5] rounded-2xl p-4 shadow-sm space-y-1.5">
                              <div class="flex items-center gap-1.5 text-[#2c1d30] font-extrabold text-[10.5px]">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                                </svg>
                                Automated Gemma Clinical Insights
                              </div>
                              <p class="text-[10px] text-[#5c4a63] font-medium leading-relaxed">
                                {latestVisit.aiPrediction}
                              </p>
                            </div>
                          ) : (
                            <p class="text-[9px] text-[#765e82] italic">No AI prognosis has been calculated yet. Log a vital checkup to trigger automated Gemma LLM risk analysis.</p>
                          )}

                          {activeP && activeP.visits && activeP.visits.length > 0 && (
                            <div class="mt-3 space-y-2">
                              <h4 class="text-[9px] font-black text-[#765e82] uppercase tracking-wider">All Historical Checkups ({activeP.visits.length})</h4>
                              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
                                {activeP.visits.map((v, idx) => {
                                  let riskCol = 'bg-emerald-50 text-emerald-800 border-emerald-200';
                                  if (v.riskCategory === RiskCategory.HIGH) riskCol = 'bg-amber-50 text-amber-800 border-amber-200';
                                  if (v.riskCategory === RiskCategory.CRITICAL) riskCol = 'bg-rose-50 text-rose-800 border-rose-200';
                                  const details = parseCheckupSymptoms(v.symptoms);
                                  return (
                                    <div class="bg-white/60 border border-[#ebdcd5]/60 rounded-2xl p-3 space-y-2 shadow-xs hover:bg-white transition-all">
                                      <div class="flex justify-between items-center text-[9.5px] font-extrabold text-[#2c1d30]">
                                        <span>Checkup {activeP.visits.length - idx}</span>
                                        <span class={`px-2 py-0.5 rounded-full text-[7.5px] font-black uppercase tracking-wider border ${riskCol}`}>{v.riskCategory}</span>
                                      </div>
                                      
                                      <div class="space-y-1 text-[9px] text-[#5c4a63]">
                                        <div><strong>Gestation:</strong> {v.gestationalWeeks} Weeks</div>
                                        <div><strong>Vitals:</strong> BP {v.systolicBP}/{v.diastolicBP} | Pulse {details.pulse || 'N/A'} bpm</div>
                                        <div><strong>Hemoglobin:</strong> {v.hemoglobin} g/dL | SpO2 {details.oxygenSat || 'N/A'}% | Temp {details.temperature || 'N/A'}°F</div>
                                        <div><strong>Urinary Protein:</strong> {details.urineProtein || 'None'}</div>
                                        {v.medications && <div><strong>Meds:</strong> {v.medications}</div>}
                                      </div>

                                      {v.adviceUrdu && (
                                        <div class="bg-[#ebdcd5]/30 border-l-2 border-[#c47c3a] p-1.5 rounded-r-lg mt-1 text-[9px] text-[#765e82] font-semibold">
                                          Urdu advice: {v.adviceUrdu}
                                        </div>
                                      )}
                                    </div>
                                  );
                                })}
                              </div>
                            </div>
                          )}
                        </div>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        )}
      </section>

